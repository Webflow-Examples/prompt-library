---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import {Search} from '../components/SearchBar/SearchBar.tsx';

// Load all prompt JSON files
const promptModules = import.meta.glob('../prompts/**/prompt.json', { eager: true });
const prompts = Object.values(promptModules)
  .map((module: any) => module.default || module)
  .filter((prompt: any) => prompt.publish !== false);
---

<Layout>
	<div class="container mx-auto">
		<Search prompts={prompts} client:load />
	</div>
</Layout>
